rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MỌI rule phải nằm bên trong khối này thì Firestore mới áp dụng
    //
    // Nguyên tắc chống spam: ai cũng tạo được tài khoản Firebase (cấu hình web là công khai), nên
    //  - tài khoản lạ chỉ làm được 2 việc: kiểm tra mã lớp đang mở và gửi MỘT đơn đăng ký (dữ liệu nhỏ, đúng mẫu);
    //  - mọi việc ghi / đọc dữ liệu học tập đều cần là học sinh đã được thầy cấp hoặc duyệt khóa học;
    //  - mỗi chỗ ghi chỉ nhận đúng các trường cho phép, có giới hạn độ dài.

    function laAdmin() {
      return request.auth != null && request.auth.token.email == 'thanhdo@dfm.com';
    }
    // Học sinh thật: đã có hồ sơ quyền khóa học do thầy cấp / duyệt
    function laHocSinh() {
      return request.auth != null
        && exists(/databases/$(database)/documents/phan_quyen/$(request.auth.token.email));
    }
    // Chỉ thêm / sửa các trường trong danh sách (trường cũ có sẵn trong tài liệu thì vẫn giữ được)
    function chiSua(truong) {
      return resource == null
        ? request.resource.data.keys().hasOnly(truong)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(truong);
    }

    // ----- Đổi email do thầy cấp (@dfm.com) sang email thật -----
    // Học sinh ghi yêu cầu đổi vào doi_email/{uid} trước khi đổi; sau khi email mới được xác minh,
    // học sinh được tự chuyển quyền khóa học từ email cũ sang email mới (và xóa quyền ở email cũ).
    function doiEmailCuaToi() {
      return get(/databases/$(database)/documents/doi_email/$(request.auth.uid)).data;
    }
    function laEmailCuCuaToi(email) {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/doi_email/$(request.auth.uid))
        && doiEmailCuaToi().emailCu == email
        && doiEmailCuaToi().emailMoi == request.auth.token.email;
    }
    match /doi_email/{uid} {
      allow get, delete: if laAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if laAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['emailCu', 'emailMoi', 'luc'])
        && request.resource.data.emailCu == request.auth.token.email
        && request.resource.data.emailMoi is string && request.resource.data.emailMoi.size() <= 100;
    }

    // Phân quyền khóa học: học sinh chỉ đọc quyền của chính mình; chỉ Admin xem tất cả và sửa
    match /phan_quyen/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || laAdmin() || laEmailCuCuaToi(email));
      allow create: if laAdmin() || (request.auth != null && request.auth.token.email == email
        && laEmailCuCuaToi(doiEmailCuaToi().emailCu)
        && request.resource.data == get(/databases/$(database)/documents/phan_quyen/$(doiEmailCuaToi().emailCu)).data);
      allow update: if laAdmin();
      allow delete: if laAdmin() || laEmailCuCuaToi(email);
    }

    // ----- Tự đăng ký bằng mã lớp, thầy duyệt -----
    // Mã lớp: ai cũng kiểm tra được mã đang mở (lúc đăng ký chưa có tài khoản); chỉ Admin tạo / sửa
    match /lop/{ma} {
      allow get: if laAdmin() || resource.data.mo == true;
      allow list, write: if laAdmin();
    }
    // Đơn đăng ký: mỗi tài khoản đúng một đơn của chính mình (đúng email, mã lớp đang mở, dữ liệu nhỏ)
    match /dang_ky/{uid} {
      allow get: if laAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, update, delete: if laAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'ten', 'maLop', 'tenLop', 'trangThai', 'cach', 'luc'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.trangThai == 'cho'
        && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 60
        && request.resource.data.tenLop is string && request.resource.data.tenLop.size() <= 80
        && request.resource.data.cach in ['email', 'google']
        && request.resource.data.luc == request.time
        && request.resource.data.maLop is string
        && get(/databases/$(database)/documents/lop/$(request.resource.data.maLop)).data.mo == true;
    }

    // Theo dõi học tập: học sinh đã được duyệt chỉ ghi vào hồ sơ của chính mình; Admin đọc tất cả,
    // học sinh đọc được hồ sơ của chính mình (trang Góc học tập)
    match /hoc_sinh/{uid} {
      allow get: if laAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, delete: if laAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && laHocSinh()
        && request.resource.data.email == request.auth.token.email
        && chiSua(['email', 'lanCuoi', 'luotVao', 'ngay', 'khoa', 'thoiGianHoc', 'soLanMoBai', 'baiCuoi', 'bai']);
      match /hoat_dong/{id} {
        allow read, delete: if laAdmin();
        allow create: if request.auth != null && request.auth.uid == uid && laHocSinh()
          && request.resource.data.keys().hasOnly(['loai', 'khoa', 'ten', 'chuong', 'url', 'luc'])
          && request.resource.data.loai in ['vao_khoa', 'mo_bai'];
      }
    }

    // Bài học thêm từ trang Admin: học sinh đã được duyệt được đọc; chỉ Admin sửa
    match /bai_hoc_them/{id} {
      allow read: if laAdmin() || laHocSinh();
      allow write: if laAdmin();
    }

    // ===== Tài liệu miễn phí (thêm ở trang Quản trị, tab Tài liệu) =====
    // Ai cũng đọc được tài liệu đang hiện, không cần đăng nhập (trang danh sách phải lọc where('an', '==', false));
    // tài liệu đang ẩn chỉ Admin xem được. Chỉ Admin sửa.
    match /tai_lieu/{id} {
      allow read: if laAdmin() || resource.data.an == false;
      allow write: if laAdmin();
    }
    // Nội dung HTML: đọc từng tài liệu một, theo trạng thái ẩn / hiện của tài liệu đó
    match /tai_lieu_noi_dung/{id} {
      allow get: if laAdmin() || get(/databases/$(database)/documents/tai_lieu/$(id)).data.an == false;
      allow list, write: if laAdmin();
    }

    // ===== Đề thi trực tuyến (tải lên từ file TeX ở trang Quản trị) =====
    // Đề: học sinh đã được duyệt đọc đề đang mở, hoặc đề mình đã nộp (để xem lại kết quả); chỉ Admin sửa
    match /de_thi/{deId} {
      allow get: if laAdmin() || (laHocSinh() && (resource.data.trangThai == 'mo'
                  || exists(/databases/$(database)/documents/bai_lam/$(deId + '__' + request.auth.uid))));
      allow list: if laAdmin() || (laHocSinh() && resource.data.trangThai == 'mo');
      allow write: if laAdmin();
    }

    // Đáp án + lời giải: học sinh chỉ đọc được khi ĐÃ NỘP bài đề đó VÀ Admin đã công bố điểm/đáp án
    // (trường congBo của đề: 'an' = chưa công bố, 'diem' = chỉ điểm, 'chi-tiet' = điểm + đúng/sai từng câu,
    //  'day-du' = điểm + đáp án + lời giải)
    match /dap_an/{deId} {
      allow get: if laAdmin() || (request.auth != null
                  && exists(/databases/$(database)/documents/bai_lam/$(deId + '__' + request.auth.uid))
                  && get(/databases/$(database)/documents/de_thi/$(deId)).data.get('congBo', 'diem') in ['diem', 'chi-tiet', 'day-du']);
      allow list, write: if laAdmin();
    }

    // Bài làm: mỗi học sinh nộp 1 lần cho mỗi đề (mã = <mã đề>__<uid>), chỉ khi đề đang mở; nộp rồi không sửa được
    match /bai_lam/{baiId} {
      allow get: if laAdmin() || (request.auth != null && baiId.split('__')[1] == request.auth.uid);
      // Học sinh liệt kê được bài của chính mình (Phòng thi hiện các đề đã nộp để xem kết quả)
      allow list: if laAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if laHocSinh()
        && request.resource.data.keys().hasOnly(['deId', 'uid', 'email', 'tieuDe', 'traLoi', 'batDau', 'thoiGianLam', 'viPham', 'tuDongNop', 'lyDoNop', 'nopLuc'])
        && baiId == request.resource.data.deId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nopLuc == request.time
        && request.resource.data.traLoi is map && request.resource.data.traLoi.size() <= 200
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() <= 200
        && get(/databases/$(database)/documents/de_thi/$(request.resource.data.deId)).data.trangThai == 'mo';
      // Học sinh không sửa được bài đã nộp; Admin chỉ được ghi điểm tự luận chấm tay
      allow update: if laAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diemTuLuan', 'chamTuLuanLuc'])
        && (!('diemTuLuan' in request.resource.data)
            || (request.resource.data.diemTuLuan is number && request.resource.data.diemTuLuan >= 0 && request.resource.data.diemTuLuan <= 10));
      allow delete: if laAdmin();
    }

    // Bảng xếp hạng các bài kiểm tra công thức: học sinh đã được duyệt chỉ đọc/ghi dòng của mình; Admin xem tất cả
    function ghiBxhHopLe(uid) {
      return request.auth != null && request.auth.uid == uid && laHocSinh()
        && chiSua(['ten', 'soLan', 'lanCuoi', 'lichSu', 'diem', 'tong', 'thoiGian', 'viPham', 'ngay'])
        && request.resource.data.ten is string
        && request.resource.data.ten.size() <= 30
        && request.resource.data.diem is int
        && request.resource.data.diem >= 0
        && request.resource.data.diem <= 10
        && request.resource.data.thoiGian is number
        && request.resource.data.thoiGian > 0
        && request.resource.data.thoiGian <= 300000
        && (!('lichSu' in request.resource.data) || (request.resource.data.lichSu is list && request.resource.data.lichSu.size() <= 100));
    }
    match /bxh_luong_giac/{uid} {
      allow get: if laAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if laAdmin();
      allow create, update: if ghiBxhHopLe(uid);
      allow delete: if false;
    }
    match /bxh_day_so_thong_ke/{uid} {
      allow get: if laAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if laAdmin();
      allow create, update: if ghiBxhHopLe(uid);
      allow delete: if false;
    }
    match /bxh_tap_hop_he_thuc_luong/{uid} {
      allow get: if laAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if laAdmin();
      allow create, update: if ghiBxhHopLe(uid);
      allow delete: if false;
    }
  }
}
